{
  "name": "@tastic/core",
  "version": "0.14.0",
  "description": "Required foundation for @tastic/* game packages: Vec2 and vector math, clamp, a dt-clamped RAF game-loop hook, and environment-capability detection (touch-primary vs. keyboard-likely)",
  "keywords": [
    "react-native",
    "expo",
    "vec2",
    "vector-math",
    "game-loop",
    "requestAnimationFrame",
    "touch-detection"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-game-core#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-game-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-game-core.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": [
    "./src/useThemedRootBackground.ts",
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./interface-orientation": {
      "react-native": "./src/interfaceOrientation/index.ts",
      "browser": "./src/interfaceOrientation/index.ts",
      "types": "./dist/interfaceOrientation/index.d.ts",
      "import": "./dist/interfaceOrientation/index.mjs",
      "require": "./dist/interfaceOrientation/index.js"
    },
    "./math": {
      "react-native": "./src/math/index.ts",
      "browser": "./src/math/index.ts",
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.mjs",
      "require": "./dist/math/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "interface-orientation": [
        "./dist/interfaceOrientation/index.d.ts"
      ],
      "math": [
        "./dist/math/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "~58.0.23",
    "expo-screen-orientation": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.88.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo-screen-orientation": ">=58.0.0",
    "expo-system-ui": ">=57.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "expo-screen-orientation": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
